<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:layout_marginBottom="@dimen/_10sdp"
    android:orientation="vertical"
>

    <RelativeLayout
        android:id="@+id/home_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:paddingTop="@dimen/_14sdp"
        android:paddingBottom="@dimen/_10sdp">

        <ImageView
            android:id="@+id/home_img"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:layout_centerVertical="true"
            android:background="#F0F4FF"
            android:padding="@dimen/_4sdp"
            app:srcCompat="@drawable/ic_home_black"
            app:tint="@color/colorPrimary" />

        <LinearLayout
            android:id="@+id/address_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_toEndOf="@+id/home_img"
            android:layout_toStartOf="@+id/menu_home"
            android:orientation="vertical">

            <TextView
                android:id="@+id/home_address_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/home_address"
                android:textColor="@color/black"
                android:textSize="@dimen/_12sdp"
                android:textFontWeight="700" />

            <TextView
                android:id="@+id/home_address_put_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/home_place"
                android:textColor="@color/grey"
                android:textSize="@dimen/_10sdp" />

        </LinearLayout>


        <ImageView
            android:id="@+id/menu_home"
            android:layout_width="@dimen/_23sdp"
            android:layout_height="@dimen/_23sdp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="@dimen/_4sdp"
            app:srcCompat="@drawable/ic_menu"
            app:tint="@color/grey" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/_6sdp"
        android:background="#F0F0F0" />

</LinearLayout>