<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="@dimen/_5sdp"
        android:paddingStart="@dimen/_4sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingEnd="@dimen/_16sdp"
        android:paddingBottom="@dimen/_8sdp">

        <ImageButton
            android:id="@+id/back_img"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_centerVertical="true"
            android:background="@null"
            android:padding="@dimen/_8sdp"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="@color/black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_toEndOf="@+id/back_img"
            android:text="@string/add_card"
            android:textColor="@color/black"
            android:textFontWeight="700"
            android:textSize="@dimen/_17sdp" />

    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/_16sdp"
            android:paddingTop="@dimen/_16sdp"
            android:paddingEnd="@dimen/_16sdp"
            android:paddingBottom="@dimen/_24sdp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_16sdp"
                android:visibility="gone"
                android:background="@drawable/feedback_bg"
                android:backgroundTint="#FFF8E1"
                android:padding="@dimen/_12sdp">

                <ImageView
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/info"
                    android:tint="#F59E0B"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/_24sdp"
                    android:text="@string/credit_amp_debit_card_fee_4_0_30_cents_per_transaction_for_card_payment"
                    android:textColor="#92400E"
                    android:textSize="@dimen/_12sdp" />

            </RelativeLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_20sdp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginHorizontal="@dimen/_2sdp"
                android:layout_marginTop="@dimen/_2sdp"
                app:cardCornerRadius="@dimen/_12sdp"
                app:cardElevation="@dimen/_2sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/_16sdp"
                    android:paddingTop="@dimen/_16sdp"
                    android:paddingEnd="@dimen/_16sdp"
                    android:paddingBottom="@dimen/_16sdp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:letterSpacing="0.08"
                        android:text="Card Details"
                        android:textAllCaps="true"
                        android:textColor="@color/grey"
                        android:textSize="@dimen/_11sdp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_15sdp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.google.android.material.textfield.TextInputLayout
                                style="@style/TextInputLayoutLeftHint"
                                android:layout_width="match_parent"
                                android:layout_gravity="center_vertical"
                                android:background="@drawable/text_field_bg"
                                android:hint="@string/card_number"
                                app:boxBackgroundColor="@android:color/transparent"
                                app:boxStrokeWidth="0dp"
                                app:boxStrokeWidthFocused="0dp"
                                app:endIconMode="clear_text"
                                app:hintTextColor="@color/edited_text_color">

                                <com.stripe.android.view.CardNumberEditText
                                    android:id="@+id/card_number_edit_text"
                                    style="@style/MediumText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="@android:color/transparent"
                                    android:gravity="center_vertical"
                                    android:imeOptions="actionNext"
                                    android:inputType="phone"
                                    android:maxLines="1"
                                    android:paddingHorizontal="@dimen/_5sdp"
                                    android:paddingVertical="@dimen/_15sdp"
                                    android:singleLine="true"
                                    android:textColor="@color/black"
                                    android:textCursorDrawable="@drawable/cursor_et"
                                    android:textSelectHandle="@drawable/cursor_et"
                                    android:theme="@style/ErrorTheme" />

                            </com.google.android.material.textfield.TextInputLayout>


                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:orientation="horizontal"
                                android:weightSum="2">

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/TextInputLayoutLeftHint"
                                    android:layout_width="0dp"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginTop="@dimen/_15sdp"
                                    android:layout_marginEnd="@dimen/_10sdp"
                                    android:layout_marginBottom="@dimen/_10sdp"
                                    android:layout_weight="1"
                                    android:background="@drawable/text_field_bg"
                                    android:hint="@string/expiry_date"
                                    app:boxBackgroundColor="@android:color/transparent"
                                    app:boxStrokeWidth="0dp"
                                    app:boxStrokeWidthFocused="0dp"
                                    app:endIconMode="clear_text"
                                    app:hintTextColor="@color/edited_text_color">

                                    <com.stripe.android.view.ExpiryDateEditText
                                        android:id="@+id/expiry_date_edit_text"
                                        style="@style/MediumText"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@android:color/transparent"
                                        android:gravity="center_vertical"
                                        android:imeOptions="actionNext"
                                        android:inputType="phone"
                                        android:maxLines="1"
                                        android:paddingHorizontal="@dimen/_5sdp"
                                        android:paddingVertical="@dimen/_15sdp"
                                        android:singleLine="true"
                                        android:textColor="@color/black"
                                        android:textCursorDrawable="@drawable/cursor_et"
                                        android:textSelectHandle="@drawable/cursor_et"
                                        android:theme="@style/ErrorTheme" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/TextInputLayoutLeftHint"
                                    android:layout_width="0dp"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginStart="@dimen/_10sdp"
                                    android:layout_marginTop="@dimen/_15sdp"
                                    android:layout_marginBottom="@dimen/_10sdp"
                                    android:layout_weight="1"
                                    android:background="@drawable/text_field_bg"
                                    app:boxBackgroundColor="@android:color/transparent"
                                    app:boxStrokeWidth="0dp"
                                    app:boxStrokeWidthFocused="0dp"
                                    app:endIconMode="clear_text"
                                    app:hintTextColor="@color/edited_text_color">

                                    <com.stripe.android.view.CvcEditText
                                        android:id="@+id/cvc_edit_text"
                                        style="@style/MediumText"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@android:color/transparent"
                                        android:gravity="center_vertical"
                                        android:imeOptions="actionDone"
                                        android:inputType="phone"
                                        android:maxLength="3"
                                        android:maxLines="1"
                                        android:minEms="3"
                                        android:paddingHorizontal="@dimen/_5sdp"
                                        android:paddingVertical="@dimen/_15sdp"
                                        android:singleLine="true"
                                        android:textColor="@color/black"
                                        android:textCursorDrawable="@drawable/cursor_et"
                                        android:textSelectHandle="@drawable/cursor_et"
                                        android:theme="@style/ErrorTheme" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        style="@style/MediumText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/credit_amp_debit_card_fee_4_0_30_cents_per_transaction_for_card_payment"
                        android:textColor="@color/edited_text_color"
                        tools:ignore="UnusedAttribute" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/confirmButton"
                style="@style/BoldTextButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50sdp"
                android:layout_marginBottom="@dimen/_12sdp"
                android:background="@drawable/custom_roundcorner_button"
                android:backgroundTint="?attr/colorPrimary"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textFontWeight="700"
                android:textSize="@dimen/_15sdp"
                tools:ignore="MissingConstraints" />

            <LinearLayout
                android:id="@+id/loadingLayout"
                style="@style/BoldTextButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_50sdp"
                android:layout_gravity="bottom"
                android:background="@drawable/custom_roundcorner_button"
                android:backgroundTint="?attr/colorPrimary"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="@dimen/_28sdp"
                    android:layout_height="@dimen/_28sdp"
                    android:indeterminateTint="@color/white"
                    android:progressTint="@color/white"
                    android:visibility="visible" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>