<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/_10sdp"
        android:paddingBottom="@dimen/_10sdp"
        android:paddingStart="@dimen/_4sdp"
        android:paddingEnd="@dimen/_5sdp">

        <ImageView
            android:id="@+id/img_cartype"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:padding="@dimen/_8sdp"
            android:background="@drawable/ic_button_bg"
            android:backgroundTint="#EEF0FF"
            app:srcCompat="@drawable/ic_sedan" />

        <TextView
            android:id="@+id/txt_car_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/img_cartype"
            android:layout_marginStart="@dimen/_12sdp"
            android:text="Basic"
            android:textColor="#1A1A2E"
            android:textFontWeight="700"
            android:textSize="@dimen/_12sdp" />

        <TextView
            android:id="@+id/txt_fare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/car_radio"
            android:layout_marginEnd="@dimen/_10sdp"
            android:text="$ 100"
            android:textColor="@color/colorPrimary"
            android:textFontWeight="700"
            android:textSize="@dimen/_12sdp" />

        <RadioButton
            android:id="@+id/car_radio"
            android:layout_centerVertical="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:buttonTint="@color/colorPrimary"
            android:clickable="false" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/_66sdp"
        android:layout_marginEnd="@dimen/_14sdp"
        android:background="#F0F2F8" />

</LinearLayout>