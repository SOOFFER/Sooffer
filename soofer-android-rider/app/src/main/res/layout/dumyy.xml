<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:padding="@dimen/_5sdp"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/title_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:gravity="center"
            android:layout_toStartOf="@+id/ic_call_imgbtn"
            android:layout_centerVertical="true"
            android:text="Currently we do not have app booking service at your location.please click on the phone icon to book manually."
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/_12sdp" />

        <ImageButton
            android:id="@+id/ic_call_imgbtn"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/ic_drop_dot"
            android:backgroundTint="@color/white"
            android:padding="@dimen/_10sdp"
            app:srcCompat="@drawable/ic_call_trip" />
    </RelativeLayout>

</LinearLayout>