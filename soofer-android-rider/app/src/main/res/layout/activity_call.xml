<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/_80sdp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/profile_image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_120sdp"
            android:layout_gravity="center"
            app:srcCompat="@drawable/my_account"
            tools:ignore="RtlCompat" />

        <TextView
            android:id="@+id/name_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:text="John Peter"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="@dimen/_22sdp"
            android:textFontWeight="700" />


    </LinearLayout>

    <Chronometer
        android:id="@+id/chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:textColor="@color/black"
        android:textSize="@dimen/_48sdp"
        android:textFontWeight="700"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/_60sdp"
        android:gravity="center"
        android:orientation="horizontal">


        <ImageView
            android:id="@+id/call_in_img"
            android:layout_width="@dimen/_64sdp"
            android:layout_height="@dimen/_64sdp"
            android:background="@drawable/ic_circle_call"
            android:backgroundTint="#4CAF50"
            android:padding="@dimen/_16sdp"
            android:visibility="invisible"
            app:srcCompat="@drawable/ic_incoming" />


        <androidx.legacy.widget.Space
            android:layout_width="@dimen/_36sdp"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/call_cut_img"
            android:layout_width="@dimen/_64sdp"
            android:layout_height="@dimen/_64sdp"
            android:background="@drawable/ic_circle_call"
            android:backgroundTint="#F44336"
            android:padding="@dimen/_16sdp"
            android:visibility="visible"
            app:srcCompat="@drawable/ic_call_cut" />

        <androidx.legacy.widget.Space
            android:layout_width="@dimen/_36sdp"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/call_cancel_img"
            android:layout_width="@dimen/_64sdp"
            android:layout_height="@dimen/_64sdp"
            android:background="@drawable/ic_circle_call"
            android:backgroundTint="#F44336"
            android:padding="@dimen/_16sdp"
            android:visibility="invisible"
            app:srcCompat="@drawable/ic_declinecall" />


    </LinearLayout>

</RelativeLayout>