<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape >
            <solid android:color="@android:color/white"/>
            <corners android:radius="5dp" />
            <stroke android:width="1dp" android:color="@color/et_stroke_color"/>

            <padding
                android:bottom="5dp"
                android:left="5dp"
                android:right="5dp"
                android:top="5dp" />

        </shape>
    </item>
    <item>
        <shape >
            <corners android:radius="10dp" />
            <solid android:color="@color/et_bgtint_color"/>
            <corners android:radius="10dp" />
            <padding
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp" />
        </shape>
    </item>
</selector>