<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:id="@+id/add_vehicle_document"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/_5sdp"
            android:padding="@dimen/_5sdp"
            android:background="@color/white">

            <ImageView
                android:id="@+id/back_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_5sdp"
                android:background="@null"
                app:srcCompat="@drawable/ic_arrow_back"
                android:tint="@color/black"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_17sdp"
                android:layout_marginStart="@dimen/_17sdp"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/back_img"
                android:text="@string/select_document"
                android:textColor="@color/black"
                android:textSize="@dimen/_15sdp"/>

        </RelativeLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_below="@+id/header"
            android:layout_above="@+id/submit_btn"
            android:fillViewport="true"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/light_grey"
                android:padding="@dimen/_10sdp"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/_5sdp"
                    android:background="@color/white"
                    android:padding="@dimen/_10sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >
                        <RelativeLayout
                            android:id="@+id/insurance_lyt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_10sdp"
                            android:gravity="center"
                            android:layout_gravity="center">
                            <TextView
                                android:id="@+id/insurance_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_14sdp"
                                android:text="@string/taxi_insurance"
                                android:layout_toStartOf="@+id/waring_img"/>
                            <ImageView
                                android:id="@+id/waring_img"
                                android:layout_toStartOf="@+id/img_expn"
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_20sdp"
                                android:layout_centerVertical="true"
                                app:srcCompat="@drawable/ic_info"
                                android:layout_marginEnd="@dimen/_10sdp"
                                />
                            <ImageView
                                android:id="@+id/img_expn"
                                android:layout_width="@dimen/_30sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                app:srcCompat="@drawable/ic_expand"/>
                            <TextView
                                android:id="@+id/missing_txt"
                                android:layout_below="@+id/insurance_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sdp"
                                android:text="@string/missing"
                                android:textColor="@color/redcolor"
                                android:layout_toStartOf="@+id/img_expn"/>
                        </RelativeLayout>
                        <View
                            android:id="@+id/view"
                            android:layout_width="match_parent"
                            android:layout_height="0.8dp"
                            android:visibility="gone"
                            android:background="@color/light_grey"/>
                        <RelativeLayout
                            android:id="@+id/upload_rlyt"
                            android:layout_width="match_parent"
                            android:visibility="gone"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_10sdp">
                            <Button
                                android:id="@+id/upload_btn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="@dimen/_5sdp"
                                android:background="@color/lite_grey"
                                android:text="@string/upload_document"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_14sdp"/>

                            <LinearLayout
                                android:visibility="visible"
                                android:id="@+id/manag_lyt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <ImageView
                                    android:id="@+id/download_img"
                                    app:srcCompat="@drawable/ic_inbox"
                                    android:layout_width="@dimen/_60sdp"
                                    android:layout_height="@dimen/_70sdp" />
                                <Button
                                    android:id="@+id/manage_btn"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="@dimen/_5sdp"
                                    android:background="@color/lite_grey"
                                    android:text="@string/manage"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:layout_marginStart="@dimen/_10sdp"
                                    android:textColor="@color/white"
                                    />
                            </LinearLayout>
                        </RelativeLayout>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/_5sdp"
                    android:background="@color/white"
                    android:padding="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >
                        <RelativeLayout
                            android:id="@+id/permit_lyt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_10sdp"
                            android:gravity="center"
                            android:layout_gravity="center">
                            <TextView
                                android:id="@+id/permit_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_14sdp"
                                android:text="@string/taxi_permit"
                                android:layout_toStartOf="@+id/ins_waring_img"/>
                            <ImageView
                                android:id="@+id/permit_waring_img"
                                android:layout_toStartOf="@+id/permit_img_expn"
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_20sdp"
                                android:layout_centerVertical="true"
                                app:srcCompat="@drawable/ic_info"
                                android:layout_marginEnd="@dimen/_10sdp"
                                />
                            <ImageView
                                android:id="@+id/permit_img_expn"
                                android:layout_width="@dimen/_30sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                app:srcCompat="@drawable/ic_expand"/>
                            <TextView
                                android:id="@+id/permit_missing_txt"
                                android:layout_below="@+id/permit_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sdp"
                                android:text="@string/missing"
                                android:textColor="@color/redcolor"
                                android:layout_toStartOf="@+id/ins_img_expn"
                                tools:ignore="UnknownIdInLayout" />
                        </RelativeLayout>
                        <View
                            android:id="@+id/permit_view"
                            android:layout_width="match_parent"
                            android:layout_height="0.8dp"
                            android:visibility="gone"
                            android:background="@color/light_grey"/>
                        <RelativeLayout
                            android:id="@+id/permit_upload_rlyt"
                            android:layout_width="match_parent"
                            android:visibility="gone"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_10sdp">
                            <Button
                                android:id="@+id/permit_upload_btn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="@dimen/_5sdp"
                                android:background="@color/lite_grey"
                                android:text="@string/upload_document"
                                android:textColor="@color/white"
                               />

                            <LinearLayout
                                android:visibility="gone"
                                android:id="@+id/permit_manag_lyt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <ImageView
                                    android:id="@+id/permit_download_img"
                                    app:srcCompat="@drawable/ic_inbox"
                                    android:layout_width="@dimen/_60sdp"
                                    android:layout_height="@dimen/_70sdp" />
                                <Button
                                    android:id="@+id/permit_manage_btn"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="@dimen/_5sdp"
                                    android:background="@color/lite_grey"
                                    android:text="@string/manage"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:layout_marginStart="@dimen/_10sdp"
                                    android:textColor="@color/white"
                                    />
                            </LinearLayout>

                        </RelativeLayout>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/_5sdp"
                    android:background="@color/white"
                    android:padding="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >
                        <RelativeLayout
                            android:id="@+id/regs_lyt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_10sdp"
                            android:gravity="center"
                            android:layout_gravity="center">
                            <TextView
                                android:id="@+id/regs_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_14sdp"
                                android:text="@string/taxi_registration_certificate"
                                android:layout_toStartOf="@+id/regs_waring_img"/>
                            <ImageView
                                android:id="@+id/regs_waring_img"
                                android:layout_toStartOf="@+id/regs_img_expn"
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_20sdp"
                                android:layout_centerVertical="true"
                                app:srcCompat="@drawable/ic_info"
                                android:layout_marginEnd="@dimen/_10sdp"
                                />
                            <ImageView
                                android:id="@+id/regs_img_expn"
                                android:layout_width="@dimen/_30sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                app:srcCompat="@drawable/ic_expand"/>
                            <TextView
                                android:id="@+id/regs_missing_txt"
                                android:layout_below="@+id/regs_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sdp"
                                android:text="@string/missing"
                                android:textColor="@color/redcolor"
                                android:layout_toStartOf="@+id/taxi_img_expn"/>
                        </RelativeLayout>
                        <View
                            android:id="@+id/regs_view"
                            android:layout_width="match_parent"
                            android:layout_height="0.8dp"
                            android:visibility="gone"
                            android:background="@color/light_grey"/>
                        <RelativeLayout
                            android:id="@+id/regs_upload_rlyt"
                            android:layout_width="match_parent"
                            android:visibility="gone"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_10sdp">
                            <Button
                                android:id="@+id/regs_upload_btn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="@dimen/_5sdp"
                                android:background="@color/lite_grey"
                                android:text="@string/upload_document"
                                android:textColor="@color/white"
                               />

                            <LinearLayout
                                android:visibility="gone"

                                android:id="@+id/regs_manag_lyt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <ImageView
                                    android:id="@+id/regs_download_img"
                                    app:srcCompat="@drawable/ic_inbox"
                                    android:layout_width="@dimen/_60sdp"
                                    android:layout_height="@dimen/_70sdp" />
                                <Button
                                    android:id="@+id/taxi_manage_btn"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="@dimen/_5sdp"
                                    android:background="@color/lite_grey"
                                    android:text="@string/manage"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:layout_marginStart="@dimen/_10sdp"
                                    android:textColor="@color/white"
                                    />
                            </LinearLayout>

                        </RelativeLayout>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/_5sdp"
                    android:background="@color/white"
                    android:padding="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_10sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        >
                        <RelativeLayout
                            android:id="@+id/fc_lyt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_10sdp"
                            android:gravity="center"
                            android:layout_gravity="center">
                            <TextView
                                android:id="@+id/fc_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_14sdp"
                                android:text="@string/fitness_certificate_option"
                                android:layout_toStartOf="@+id/fc_waring_img"/>
                            <ImageView
                                android:id="@+id/fc_waring_img"
                                android:layout_toStartOf="@+id/fc_img_expn"
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_20sdp"
                                android:layout_centerVertical="true"
                                app:srcCompat="@drawable/ic_info"
                                android:layout_marginEnd="@dimen/_10sdp"
                                />
                            <ImageView
                                android:id="@+id/fc_img_expn"
                                android:layout_width="@dimen/_30sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                app:srcCompat="@drawable/ic_expand"/>
                            <TextView
                                android:id="@+id/fc_missing_txt"
                                android:layout_below="@+id/fc_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/_12sdp"
                                android:text="Missing"
                                android:textColor="@color/redcolor"
                                android:layout_toStartOf="@+id/taxi_img_expn"/>
                        </RelativeLayout>
                        <View
                            android:id="@+id/fc_view"
                            android:layout_width="match_parent"
                            android:layout_height="0.8dp"
                            android:visibility="gone"
                            android:background="@color/light_grey"/>
                        <RelativeLayout
                            android:id="@+id/fc_upload_rlyt"
                            android:layout_width="match_parent"
                            android:visibility="gone"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_10sdp">
                            <Button
                                android:id="@+id/fc_upload_btn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="@dimen/_5sdp"
                                android:background="@color/lite_grey"
                                android:text="UPLOAD DOCUMENT"
                                android:textColor="@color/white"
                              />

                            <LinearLayout
                                android:visibility="gone"

                                android:id="@+id/fc_manag_lyt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">
                                <ImageView
                                    android:id="@+id/fc_download_img"
                                    app:srcCompat="@drawable/ic_inbox"
                                    android:layout_width="@dimen/_60sdp"
                                    android:layout_height="@dimen/_70sdp" />
                                <Button
                                    android:id="@+id/fc_manage_btn"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="@dimen/_5sdp"
                                    android:background="@color/lite_grey"
                                    android:text="@string/manage"
                                    android:gravity="center"
                                    android:layout_gravity="center"
                                    android:layout_marginStart="@dimen/_10sdp"
                                    android:textColor="@color/white"
                                    />
                            </LinearLayout>

                        </RelativeLayout>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </ScrollView>


        <Button
            android:id="@+id/submit_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/colorPrimary"
            android:text="@string/submit"
            android:textColor="@color/white"
            android:layout_margin="@dimen/_10sdp"/>

    </RelativeLayout>

</FrameLayout>