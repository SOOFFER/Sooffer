<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:clickable="true"
    android:id="@+id/rating_container"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/_5sdp"
            android:padding="@dimen/_5sdp"
            android:background="@color/white">

            <ImageView
                android:id="@+id/back_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_17sdp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_10sdp"
                android:background="@null"
                app:srcCompat="@drawable/ic_arrow_back"
                app:tint="@color/black"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_17sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_toEndOf="@+id/back_img"
                android:layout_centerVertical="true"
                android:text="@string/rating"
                android:textColor="@color/black"
                android:textSize="@dimen/_15sdp"/>

        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/header"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:weightSum="1">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_weight="0.5"
                    android:layout_height="0dp"
                    android:background="@color/white">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_above="@+id/view"
                        android:gravity="center">
                        <RelativeLayout
                            android:id="@+id/ovral_rating_lyt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center">
                        <ImageView
                            android:id="@+id/star_img"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_50sdp"
                            android:src="@drawable/star"/>
                        <TextView
                            android:id="@+id/ovrall_rating_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toRightOf="@+id/star_img"
                            android:text="0.00"
                            android:maxLength="4"
                            android:maxLines="1"
                            android:layout_marginLeft="10dp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="@dimen/_40sdp"
                            />
                        </RelativeLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/ovral_rating_lyt"
                            android:text="@string/your_current_rating"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_15sdp"
                            android:gravity="center"
                            />

                    </RelativeLayout>

                    <View
                        android:id="@+id/view"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:background="@color/grey"
                        android:layout_above="@+id/lyt_rating"
                        />

                    <LinearLayout
                        android:id="@+id/lyt_rating"
                        android:layout_width="match_parent"
                        android:layout_alignParentBottom="true"
                        android:layout_height="wrap_content"
                        android:weightSum="3"
                        android:maxLines="1"
                        android:background="@color/light_grey"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/lifetime_count_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:maxLines="1"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:textAppearance="?android:attr/textAppearanceMedium"/>
                            <TextView
                                android:id="@+id/lifetime_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/lifetime_trips"
                                android:textAllCaps="true"
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:textSize="@dimen/_12sdp"
                                />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/rated_count_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="0"
                                android:textAppearance="?android:attr/textAppearanceMedium"
                                android:textColor="@color/black"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/rated_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/rated_trips"
                                android:textAllCaps="true"
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:textSize="@dimen/_12sdp"
                                />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/star_count_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:maxLines="1"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:textAppearance="?android:attr/textAppearanceMedium"/>
                            <TextView
                                android:id="@+id/star_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/fivestar_trips"
                                android:textAllCaps="true"
                                android:textColor="@color/black"
                                android:gravity="center"
                                android:textSize="@dimen/_12sdp"
                                />
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_weight="0.5"
                    android:layout_height="0dp">

                    <RelativeLayout
                        android:id="@+id/feedback_lyt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/_13sdp"
                        >

                        <ImageView
                            android:id="@+id/feedback_image"
                            android:layout_width="@dimen/_28sdp"
                            android:layout_height="@dimen/_28sdp"
                            app:srcCompat="@drawable/ic_chat_black"
                            android:tint="@color/grey"
                            android:layout_marginLeft="3dp"
                            />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toRightOf="@+id/feedback_image"
                            android:layout_toLeftOf="@+id/feedback_next_image"
                            android:orientation="vertical"
                            android:layout_marginLeft="10dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/feedback"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:textAppearance="?android:attr/textAppearanceMedium"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/feedback_content"
                                android:layout_marginTop="@dimen/_8sdp"
                                />


                        </LinearLayout>

                        <ImageView
                            android:id="@+id/feedback_next_image"
                            android:layout_width="@dimen/_25sdp"
                            android:layout_height="@dimen/_25sdp"
                            app:srcCompat="@drawable/ic_arrow_right"
                            android:tint="@color/grey"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            />

                    </RelativeLayout>

                    <View
                        android:layout_below="@+id/feedback_lyt"
                        android:layout_width="match_parent"
                        android:layout_height="0.5dp"
                        android:background="@color/grey"
                        android:layout_marginTop="@dimen/_15sdp"
                        />

                </RelativeLayout>

            </LinearLayout>
        </ScrollView>

    </RelativeLayout>

</FrameLayout>