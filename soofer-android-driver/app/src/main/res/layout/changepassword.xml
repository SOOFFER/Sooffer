<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F6F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_5sdp"
        android:background="@color/white"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_5sdp"
            android:text="Change Password"
            android:textColor="@color/black"
            android:textSize="@dimen/_17sdp"
            android:textFontWeight="700" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:text="Enter your current and new password below"
            android:textColor="@color/grey"
            android:textSize="@dimen/_12sdp" />

        <com.soofer.driver.CommonClass.Customizeview.CustomEditText
            android:id="@+id/old_password_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/ic_hide"
            android:drawablePadding="@dimen/_5sdp"
            android:hint="@string/enter_old_passwordss"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/black"
            android:textColorHint="@color/grey"
            android:textSize="@dimen/_14sdp"
            app:met_baseColor="@color/black"
            app:met_floatingLabel="highlight"
            app:met_floatingLabelTextColor="@color/colorPrimary"
            app:met_primaryColor="?colorAccent"
            app:met_singleLineEllipsis="true" />

        <com.soofer.driver.CommonClass.Customizeview.CustomEditText
            android:id="@+id/new_password_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:drawableEnd="@drawable/ic_hide"
            android:drawablePadding="@dimen/_5sdp"
            android:hint="@string/enter_new_passwordss"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/black"
            android:textColorHint="@color/grey"
            android:textSize="@dimen/_14sdp"
            app:met_baseColor="@color/black"
            app:met_floatingLabel="highlight"
            app:met_floatingLabelTextColor="@color/colorPrimary"
            app:met_primaryColor="?colorAccent"
            app:met_singleLineEllipsis="true" />

        <com.soofer.driver.CommonClass.Customizeview.CustomEditText
            android:id="@+id/password_again_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:drawableEnd="@drawable/ic_hide"
            android:drawablePadding="@dimen/_5sdp"
            android:hint="Confirm New Password"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/black"
            android:textColorHint="@color/grey"
            android:textSize="@dimen/_14sdp"
            app:met_baseColor="@color/black"
            app:met_floatingLabel="highlight"
            app:met_floatingLabelTextColor="@color/colorPrimary"
            app:met_primaryColor="?colorAccent"
            app:met_singleLineEllipsis="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/_16sdp"
            android:background="#F0F0F0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:paddingTop="@dimen/_6sdp"
            android:paddingBottom="@dimen/_6sdp">

            <TextView
                android:id="@+id/cancel_txt"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_40sdp"
                android:gravity="center"
                android:paddingStart="@dimen/_16sdp"
                android:paddingEnd="@dimen/_16sdp"
                android:text="Cancel"
                android:textColor="@color/grey"
                android:textSize="@dimen/_13sdp"
                android:textFontWeight="700" />

            <TextView
                android:id="@+id/ok_txt"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:background="@drawable/corner"
                android:backgroundTint="@color/colorPrimary"
                android:gravity="center"
                android:paddingStart="@dimen/_24sdp"
                android:paddingEnd="@dimen/_24sdp"
                android:text="Update"
                android:textColor="@color/white"
                android:textSize="@dimen/_13sdp"
                android:textFontWeight="700" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>