<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardBackgroundColor="@color/white"
    app:cardElevation="@dimen/_5sdp"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_10sdp">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_toStartOf="@+id/checkbox_prize"
            android:layout_marginEnd="@dimen/_10sdp"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/service_txt"
                android:textColor="@color/lite_grey"
                android:textSize="@dimen/_13sdp"
                android:text="Package Test 1 Subscription"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/discount_amount_txt"
                android:layout_marginTop="@dimen/_10sdp"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_13sdp"
                android:text="$ 100"/>
        </LinearLayout>
        <com.soofer.driver.CommonClass.Customizeview.CustomizeCheckbox
            android:layout_width="@dimen/_25sdp"
            android:layout_alignParentEnd="true"
            android:id="@+id/checkbox_prize"
            android:button="@null"
            android:clickable="false"
            android:layout_centerVertical="true"
            android:layout_height="@dimen/_25sdp" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>