                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:padding="@dimen/_10sdp">

                            <TextView
                                android:id="@+id/ownerback_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_toStartOf="@+id/ownerback_waring_img"
                                android:text="@string/owner_address_proof_back"
                                android:textSize="@dimen/_14sdp" />

                            <ImageView
                                android:id="@+id/ownerback_waring_img"
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_20sdp"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="@dimen/_10sdp"
                                android:layout_toStartOf="@+id/ownerback_img_expn"
                                app:srcCompat="@drawable/ic_info" />

                            <ImageView
                                android:id="@+id/ownerback_img_expn"
                                android:layout_width="@dimen/_30sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:layout_alignParentRight="true"
                                android:layout_centerVertical="true"
                                app:srcCompat="@drawable/ic_expand" />

                            <TextView
                                android:id="@+id/ownerback_missing_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/ownerback_txt"
                                android:layout_toLeftOf="@+id/ownerback_img_expn"
                                android:text="@string/missing"
                                android:textColor="@color/redcolor"
                                android:textSize="@dimen/_12sdp" />
                        </RelativeLayout>

                        <View
                            android:id="@+id/ownerback_view"
                            android:layout_width="match_parent"
                            android:layout_height="0.8dp"
                            android:background="@color/light_grey"
                            android:visibility="gone" />

                        <RelativeLayout
                            android:id="@+id/ownerback_upload_rlyt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_10sdp"
                            android:visibility="gone">

                            <Button
                                android:id="@+id/ownerback_upload_btn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/lite_grey"
                                android:text="@string/upload_document"
                                android:textColor="@color/white"
                                />

                            <LinearLayout
                                android:id="@+id/ownerback_manag_lyt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <ImageView
                                    android:id="@+id/ownerback_download_img"
                                    android:layout_width="@dimen/_60sdp"
                                    android:layout_height="@dimen/_70sdp"
                                    app:srcCompat="@drawable/ic_inbox" />

                                <Button
                                    android:id="@+id/ownerback_manage_btn"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginStart="@dimen/_10sdp"
                                    android:background="@color/lite_grey"
                                    android:gravity="center"
                                    android:text="@string/manage"
                                    android:textColor="@color/white"
                                     />
                            </LinearLayout>

                        </RelativeLayout>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@color/white"
                    android:padding="@dimen/_10sdp"
                    android:visibility="visible"
                    app:cardCornerRadius="@dimen/_5sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:id="@+id/taxi_lyt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:padding="@dimen/_10sdp">

                            <TextView
                                android:id="@+id/taxi_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_toStartOf="@+id/taxi_waring_img"
                                android:text="@string/driver_address_proof_front"
                                android:textSize="@dimen/_14sdp" />

                            <ImageView
                                android:id="@+id/taxi_waring_img"
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_20sdp"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="@dimen/_10sdp"
                                android:layout_toStartOf="@+id/taxi_img_expn"
                                app:srcCompat="@drawable/ic_info" />

                            <ImageView
                                android:id="@+id/taxi_img_expn"
                                android:layout_width="@dimen/_30sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                app:srcCompat="@drawable/ic_expand" />

                            <TextView
                                android:id="@+id/taxi_missing_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/taxi_txt"
                                android:layout_toStartOf="@+id/taxi_img_expn"
                                android:text="@string/missing"
                                android:textColor="@color/redcolor"
                                android:textSize="@dimen/_12sdp" />
                        </RelativeLayout>

                        <View
                            android:id="@+id/taxi_view"
                            android:layout_width="match_parent"
                            android:layout_height="0.8dp"
                            android:background="@color/light_grey"
                            android:visibility="gone" />

                        <RelativeLayout
                            android:id="@+id/taxi_upload_rlyt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_10sdp"
                            android:visibility="gone">

                            <Button
                                android:id="@+id/taxi_upload_btn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/lite_grey"
                                android:text="@string/upload_document"
                                android:textColor="@color/white"
                                />

                            <LinearLayout
                                android:id="@+id/taxi_manag_lyt"

                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:visibility="gone">

                                <ImageView
                                    android:id="@+id/taxi_download_img"
                                    android:layout_width="@dimen/_60sdp"
                                    android:layout_height="@dimen/_70sdp"
                                    app:srcCompat="@drawable/ic_inbox" />

                                <Button
                                    android:id="@+id/taxi_manage_btn"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginStart="@dimen/_10sdp"
                                    android:background="@color/lite_grey"
                                    android:gravity="center"
                                    android:text="@string/manage"
                                    android:textColor="@color/white"
                                     />
                            </LinearLayout>

                        </RelativeLayout>
                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@color/white"
                    android:padding="@dimen/_10sdp"
                    android:visibility="visible"
                    app:cardCornerRadius="@dimen/_5sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:id="@+id/driveraddress_lyt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:padding="@dimen/_10sdp">

                            <TextView
                                android:id="@+id/driveraddress_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_toStartOf="@+id/driveraddress_waring_img"
                                android:text="@string/driver_address_proof_back"
                                android:textSize="@dimen/_14sdp" />

                            <ImageView
                                android:id="@+id/driveraddress_waring_img"
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_20sdp"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="@dimen/_10sdp"
                                android:layout_toStartOf="@+id/driveraddress_img_expn"
                                app:srcCompat="@drawable/ic_info" />

                            <ImageView
                                android:id="@+id/driveraddress_img_expn"
                                android:layout_width="@dimen/_30sdp"
                                android:layout_height="@dimen/_25sdp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                app:srcCompat="@drawable/ic_expand" />

                            <TextView
                                android:id="@+id/driveraddress_missing_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/driveraddress_txt"
                                android:layout_toStartOf="@+id/driveraddress_img_expn"
                                android:text="@string/missing"
                                android:textColor="@color/redcolor"
                                android:textSize="@dimen/_12sdp" />
                        </RelativeLayout>

                        <View
                            android:id="@+id/driveraddress_view"
                            android:layout_width="match_parent"
                            android:layout_height="0.8dp"
                            android:background="@color/light_grey"
                            android:visibility="gone" />

                        <RelativeLayout
                            android:id="@+id/driveraddress_upload_rlyt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_10sdp"
                            android:visibility="gone">

                            <Button
                                android:id="@+id/driveraddress_upload_btn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/lite_grey"
                                android:text="@string/upload_document"
                                android:textColor="@color/white"
                                 />

                            <LinearLayout
                                android:id="@+id/driveraddress_manag_lyt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:visibility="gone">

