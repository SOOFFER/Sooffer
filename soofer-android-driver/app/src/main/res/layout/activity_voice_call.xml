<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_audio_chat_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/callBackground">

    <RelativeLayout
        android:id="@+id/remote_video_view_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/callBackground">

        <View
            android:id="@+id/pulse_ring_outer"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="140dp"
            android:background="@drawable/bg_pulse_ring"
            android:alpha="0.15" />

        <View
            android:id="@+id/pulse_ring_middle"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="160dp"
            android:background="@drawable/bg_pulse_ring"
            android:alpha="0.25" />

        <View
            android:id="@+id/pulse_ring_inner"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="180dp"
            android:background="@drawable/bg_pulse_ring"
            android:alpha="0.4" />

        <ImageView
            android:id="@+id/img_avatar"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="200dp"
            android:src="@drawable/ic_user_avatar"
            android:background="@drawable/bg_avatar_circle"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tv_caller_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/img_avatar"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:text="UserName"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tv_call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_caller_name"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:text="Ringing..."
            android:textColor="@color/statusTextColor"
            android:textSize="15sp"
            android:fontFamily="sans-serif" />

        <TextView
            android:id="@+id/tv_call_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_call_status"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="6dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="28sp"
            android:fontFamily="sans-serif-light"
            android:visibility="gone" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/control_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="32dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp">

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <ImageView
                android:id="@+id/btn_mute"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_centerInParent="true"
                android:onClick="onLocalAudioMuteClicked"
                android:padding="16dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mic_on"
                android:background="@drawable/bg_button_secondary"
                android:elevation="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btn_mute"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:text="Mute"
                android:textColor="@color/labelTextColor"
                android:textSize="12sp" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <ImageView
                android:id="@+id/btn_call"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_centerInParent="true"
                android:onClick="onCallClicked"
                android:padding="18dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_call_end"
                android:background="@drawable/bg_button_end_call"
                android:elevation="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btn_call"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:text="End"
                android:textColor="@color/labelTextColor"
                android:textSize="12sp" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <ImageView
                android:id="@+id/btn_speaker"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_centerInParent="true"
                android:onClick="onSpeakerClicked"
                android:padding="16dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_speaker_off"
                android:background="@drawable/bg_button_secondary"
                android:elevation="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/btn_speaker"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:text="Speaker"
                android:textColor="@color/labelTextColor"
                android:textSize="12sp" />

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>