<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ProgressWheel="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:clickable="true"
    android:addStatesFromChildren="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/request_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_12sdp"
                    android:background="@drawable/ic_button_bg"
                    android:backgroundTint="@color/white"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/_16sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/_14sdp"
                        android:paddingTop="@dimen/_14sdp"
                        android:paddingEnd="@dimen/_14sdp"
                        android:paddingBottom="@dimen/_8sdp">

                        <TextView
                            android:id="@+id/date_time_txt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Date time"
                            android:textAllCaps="true"
                            android:textColor="#8A8A8A"
                            android:textSize="@dimen/_12sdp"
                            android:textStyle="bold"
                            android:visibility="invisible" />

                        <TextView
                            android:id="@+id/decline_request_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ic_button_bg"
                            android:backgroundTint="#FFF0F0"
                            android:layout_gravity="end"
                            android:paddingStart="@dimen/_12sdp"
                            android:paddingTop="@dimen/_10sdp"
                            android:paddingEnd="@dimen/_12sdp"
                            android:paddingBottom="@dimen/_10sdp"
                            android:text="@string/decline"
                            android:textAllCaps="true"
                            android:textColor="@color/redcolor"
                            android:textSize="@dimen/_13sdp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/service_txt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:gravity="center"
                        android:textAllCaps="true"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/_18sdp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/est_txt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:gravity="center"
                        android:textColor="@color/grey"
                        android:textSize="@dimen/_12sdp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/trip_type_txt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:gravity="center"
                        android:textAllCaps="true"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_16sdp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/map_view"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:layout_centerInParent="true"
                            android:background="@color/white" />

                        <com.soofer.driver.CommonClass.ProgressWheel
                            android:id="@+id/progressBarTwo"
                            android:layout_width="170dp"
                            android:layout_height="170dp"
                            android:layout_centerInParent="true"
                            android:layout_gravity="center"
                            ProgressWheel:pwBarColor="@color/colorPrimary"
                            ProgressWheel:pwBarLength="50dp"
                            ProgressWheel:pwBarWidth="2dp"
                            ProgressWheel:pwRimColor="#E8E8E8"
                            ProgressWheel:pwRimWidth="4dp"
                            ProgressWheel:pwSpinSpeed="2dp"
                            ProgressWheel:pwTextColor="#00000000"
                            ProgressWheel:pwTextSize="14sp" />

                    </RelativeLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/request_layout"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_70sdp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_2sdp"
                        android:background="@drawable/ic_button_bg"
                        android:backgroundTint="@color/white"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="@dimen/_12sdp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <FrameLayout
                                android:id="@+id/pickup_img"
                                android:layout_width="@dimen/_32sdp"
                                android:layout_height="@dimen/_32sdp">

                                <View
                                    android:layout_width="@dimen/_32sdp"
                                    android:layout_height="@dimen/_32sdp"
                                    android:background="@drawable/circle_green_light" />

                                <ImageView
                                    android:layout_width="@dimen/_16sdp"
                                    android:layout_height="@dimen/_16sdp"
                                    android:layout_gravity="center"
                                    app:srcCompat="@drawable/ic_location"
                                    app:tint="@color/colorPrimary1" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/pickup_address_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:layout_toEndOf="@id/pickup_img"
                                android:maxLines="2"
                                android:layout_centerVertical="true"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/_13sdp"
                            android:layout_marginStart="@dimen/_15sdp"
                            android:background="#D8D8D8" />

                        <RelativeLayout
                            android:id="@+id/stop_1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">

                            <FrameLayout
                                android:id="@+id/stop1"
                                android:layout_width="@dimen/_32sdp"
                                android:layout_height="@dimen/_32sdp">

                                <View
                                    android:layout_width="@dimen/_32sdp"
                                    android:layout_height="@dimen/_32sdp"
                                    android:background="@drawable/circle_primary_light" />

                                <ImageView
                                    android:layout_width="@dimen/_16sdp"
                                    android:layout_height="@dimen/_16sdp"
                                    android:layout_gravity="center"
                                    app:srcCompat="@drawable/stop_dot"
                                    app:tint="@color/colorPrimary1" />
                            </FrameLayout>


                            <TextView
                                android:id="@+id/first_stop"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:layout_toEndOf="@id/stop1"
                                android:layout_centerVertical="true"
                                android:maxLines="1"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_11sdp" />
                        </RelativeLayout>

                        <View
                            android:id="@+id/stopView"
                            android:layout_width="1dp"
                            android:layout_height="@dimen/_13sdp"
                            android:layout_marginStart="@dimen/_15sdp"
                            android:visibility="gone"
                            android:background="#D8D8D8" />

                        <RelativeLayout
                            android:id="@+id/stop_2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">

                            <FrameLayout
                                android:id="@+id/stop2"
                                android:layout_width="@dimen/_32sdp"
                                android:layout_height="@dimen/_32sdp">

                                <View
                                    android:layout_width="@dimen/_32sdp"
                                    android:layout_height="@dimen/_32sdp"
                                    android:background="@drawable/circle_primary_light" />

                                <ImageView
                                    android:layout_width="@dimen/_16sdp"
                                    android:layout_height="@dimen/_16sdp"
                                    android:layout_gravity="center"
                                    app:srcCompat="@drawable/stop_dot"
                                    app:tint="@color/colorPrimary1" />
                            </FrameLayout>


                            <TextView
                                android:id="@+id/second_stop"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:layout_toEndOf="@id/stop2"
                                android:layout_centerVertical="true"
                                android:maxLines="1"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_11sdp" />
                        </RelativeLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/_13sdp"
                            android:layout_marginStart="@dimen/_15sdp"
                            android:background="#D8D8D8" />

                        <RelativeLayout
                            android:id="@+id/drop_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <FrameLayout
                                android:id="@+id/drop_img"
                                android:layout_width="@dimen/_32sdp"
                                android:layout_height="@dimen/_32sdp">

                                <View
                                    android:layout_width="@dimen/_32sdp"
                                    android:layout_height="@dimen/_32sdp"
                                    android:background="@drawable/circle_red_light" />

                                <ImageView
                                    android:layout_width="@dimen/_16sdp"
                                    android:layout_height="@dimen/_16sdp"
                                    android:layout_gravity="center"
                                    app:srcCompat="@drawable/ic_location"
                                    app:tint="@color/colorPrimary1" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/destination_address_txt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:layout_toEndOf="@id/drop_img"
                                android:maxLines="2"
                                android:layout_centerVertical="true"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_12sdp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp">

                        <TextView
                            android:id="@+id/km_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:background="@drawable/ic_button_bg"
                            android:backgroundTint="#ECECEC"
                            android:paddingStart="@dimen/_14sdp"
                            android:paddingTop="@dimen/_6sdp"
                            android:paddingEnd="@dimen/_14sdp"
                            android:paddingBottom="@dimen/_6sdp"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_12sdp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/fare_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:background="@drawable/ic_button_bg"
                            android:backgroundTint="@color/colorPrimary"
                            android:elevation="2dp"
                            android:paddingStart="@dimen/_16sdp"
                            android:paddingTop="@dimen/_6sdp"
                            android:paddingEnd="@dimen/_16sdp"
                            android:paddingBottom="@dimen/_6sdp"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_12sdp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/ltSecondDriver"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:background="@drawable/ic_button_bg"
                        android:backgroundTint="@color/white"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="@dimen/_12sdp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/edtMake"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawableStart="@drawable/ic_electric_car"
                                android:drawablePadding="@dimen/_8sdp"
                                android:padding="@dimen/_6sdp"
                                android:textColor="#555555"
                                android:textSize="@dimen/_12sdp" />

                            <TextView
                                android:id="@+id/edtModel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawableStart="@drawable/ic_steering_wheel"
                                android:drawablePadding="@dimen/_8sdp"
                                android:padding="@dimen/_6sdp"
                                android:textColor="#555555"
                                android:textSize="@dimen/_12sdp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:layout_marginBottom="@dimen/_6sdp"
                            android:background="#EEEEEE" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/edtNumber"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawableStart="@drawable/ic_license_plate"
                                android:drawablePadding="@dimen/_8sdp"
                                android:padding="@dimen/_6sdp"
                                android:textColor="#555555"
                                android:textSize="@dimen/_12sdp" />

                            <TextView
                                android:id="@+id/edtcolor"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:drawableStart="@drawable/ic_dot"
                                android:drawablePadding="@dimen/_8sdp"
                                android:padding="@dimen/_6sdp"
                                android:textColor="#555555"
                                android:textSize="@dimen/_12sdp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:layout_marginBottom="@dimen/_6sdp"
                            android:background="#EEEEEE" />

                        <TextView
                            android:id="@+id/note"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/_4sdp"
                            android:text="@string/driver_assign_note"
                            android:textColor="#888888"
                            android:textSize="@dimen/_11sdp" />
                    </LinearLayout>

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/accept_request_txt"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginEnd="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_14sdp"
                    android:background="@drawable/ic_button_bg"
                    android:backgroundTint="@color/colorPrimary"
                    android:elevation="6dp"
                    android:text="@string/tap_accept"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_14sdp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/cancel_request_txt"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_alignParentBottom="true"
                    android:layout_marginStart="@dimen/_16sdp"
                    android:layout_marginEnd="@dimen/_16sdp"
                    android:layout_marginBottom="@dimen/_14sdp"
                    android:background="@drawable/ic_button_bg"
                    android:backgroundTint="@color/redcolor"
                    android:elevation="6dp"
                    android:text="@string/cancel_trip"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_14sdp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </RelativeLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>