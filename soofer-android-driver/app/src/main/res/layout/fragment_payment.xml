<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FB"
    android:clickable="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <RelativeLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:elevation="@dimen/_5sdp"
            android:paddingStart="@dimen/_4sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingEnd="@dimen/_16sdp"
            android:paddingBottom="@dimen/_8sdp">


            <ImageButton
                android:id="@+id/back_img"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_4sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/_8sdp"
                android:tint="@color/black"
                app:srcCompat="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/title_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_toEndOf="@+id/back_img"
                android:text="@string/bank_details"
                android:textColor="@color/black"
                android:textSize="@dimen/_15sdp"
                android:textFontWeight="700" />

        </RelativeLayout>



        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/header"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/_16sdp"
                android:paddingBottom="@dimen/_20sdp"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_12sdp">

                <androidx.cardview.widget.CardView
                    xmlns:card_view="http://schemas.android.com/apk/res-auto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp"
                    card_view:cardBackgroundColor="@color/white"
                    card_view:cardCornerRadius="@dimen/_12sdp"
                    card_view:cardElevation="@dimen/_4sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/_16sdp"
                        android:paddingEnd="@dimen/_16sdp"
                        android:paddingTop="@dimen/_8sdp"
                        android:paddingBottom="@dimen/_16sdp">

                        <com.rengwuxian.materialedittext.MaterialEditText
                            android:id="@+id/email_edt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789qwertzuiopasdfghjklyxcvbnm@."
                            android:hint="@string/payment_email"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/black"
                            android:textColorHint="@color/grey"
                            android:textSize="@dimen/_15sdp"
                            app:met_baseColor="@color/black"
                            app:met_floatingLabel="highlight"
                            app:met_floatingLabelTextColor="@color/colorPrimary"
                            app:met_primaryColor="?colorAccent"
                            app:met_singleLineEllipsis="true" />

                        <com.rengwuxian.materialedittext.MaterialEditText
                            android:id="@+id/acc_name_edt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:digits="qwertyuiopasdfghjklzxcvbnm"
                            android:hint="@string/acc_name"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="#1A1A2E"
                            android:textColorHint="#AAAAAA"
                            android:textSize="@dimen/_15sdp"
                            app:met_baseColor="#DADCE8"
                            app:met_floatingLabel="highlight"
                            app:met_floatingLabelTextColor="@color/colorPrimary"
                            app:met_primaryColor="?colorAccent"
                            app:met_singleLineEllipsis="true" />

                        <com.rengwuxian.materialedittext.MaterialEditText
                            android:id="@+id/acc_num_edt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789"
                            android:hint="@string/acc_number"
                            android:imeOptions="actionNext"
                            android:inputType="phone"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/black"
                            android:textColorHint="@color/grey"
                            android:textSize="@dimen/_15sdp"
                            app:met_baseColor="@color/black"
                            app:met_floatingLabel="highlight"
                            app:met_floatingLabelTextColor="@color/colorPrimary"
                            app:met_primaryColor="?colorAccent"
                            app:met_singleLineEllipsis="true" />

                        <com.rengwuxian.materialedittext.MaterialEditText
                            android:id="@+id/bnk_lcn_edt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="qwertyuiopasdfghjklzxcvbnm"
                            android:hint="@string/bnk_location"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLines="1"
                            android:text=""
                            android:textColor="@color/black"
                            android:textColorHint="@color/grey"
                            android:textSize="@dimen/_15sdp"
                            app:met_baseColor="@color/black"
                            app:met_floatingLabel="highlight"
                            app:met_floatingLabelTextColor="@color/colorPrimary"
                            app:met_primaryColor="?colorAccent"
                            app:met_singleLineEllipsis="true" />

                        <com.rengwuxian.materialedittext.MaterialEditText
                            android:id="@+id/bank_name_edt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:digits="qwertyuiopasdfghjklzxcvbnm"
                            android:hint="@string/bnk_name"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="#1A1A2E"
                            android:textColorHint="#AAAAAA"
                            android:textSize="@dimen/_15sdp"
                            app:met_baseColor="#DADCE8"
                            app:met_floatingLabel="highlight"
                            app:met_floatingLabelTextColor="@color/colorPrimary"
                            app:met_primaryColor="?colorAccent"
                            app:met_singleLineEllipsis="true" />

                        <com.rengwuxian.materialedittext.MaterialEditText
                            android:id="@+id/bic_code_edt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/bic_code"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLines="1"
                            android:textColor="@color/black"
                            android:textColorHint="@color/grey"
                            android:textSize="@dimen/_15sdp"
                            app:met_baseColor="@color/black"
                            app:met_floatingLabel="highlight"
                            app:met_floatingLabelTextColor="@color/colorPrimary"
                            app:met_primaryColor="?colorAccent"
                            app:met_singleLineEllipsis="true" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/submit_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:background="@drawable/activity_bg"
                    android:backgroundTint="@color/colorPrimary"
                    android:text="@string/submit"
                    android:textColor="@color/white"
                    android:textFontWeight="700"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    android:stateListAnimator="@null"
                    android:elevation="@dimen/_4sdp"
                    android:paddingTop="@dimen/_12sdp"
                    android:paddingBottom="@dimen/_12sdp" />

            </LinearLayout>

        </ScrollView>

    </RelativeLayout>

</FrameLayout>